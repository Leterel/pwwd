<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="pwwd"
    Manufacturer="Merlin Erdogmus"
    Version="0.1.0"
    UpgradeCode="D9F73D5B-19E5-4C38-A5A8-91B94D6F1C82"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of pwwd is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="pwwd">
        <Component Id="MainExecutable" Guid="*">
          <File
            Id="PwwdExe"
            Source="dist\win-x64\pwwd.exe"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="pwwd" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>

  </Package>
</Wix>
